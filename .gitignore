# ======================================================
# IGNORE ALL CSV FILES (raw + processed)
# ======================================================

*.csv
!data/raw_data/.gitkeep
!data/processed_data/.gitkeep

# Keep Parquet files
*.parquet

# ======================================================
# DATA DIRECTORIES
# ======================================================

# Ignore raw data
data/raw_data/*
!data/raw_data/.gitkeep

# Keep processed Parquet files
!data/processed_data/
!data/processed_data/**/*.parquet

# ======================================================
# PYTHON / ENV / BUILD
# ======================================================

__pycache__/
*.py[cod]
*$py.class
*.so

.env
.env.local

# Virtual environments
venv/
env/
ENV/
.venv/

# Build + dist
build/
dist/
.eggs/
*.egg-info/

# ======================================================
# JUPYTER / EDITOR / OS GARBAGE
# ======================================================

.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store
Thumbs.db
