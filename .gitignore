# ======================================================
# DATA CONTROL
# ======================================================

# Ignore ALL CSV files everywhere
*.csv

# Ignore raw data entirely
data/raw_data/*
!data/raw_data/.gitkeep

# Keep processed data folder (for Parquet)
!data/processed_data/
!data/processed_data/**
# But ignore any CSV inside processed_data too
data/processed_data/*.csv

# Keep Parquet files
!data/processed_data/*.parquet

# ======================================================
# PYTHON / BUILD FILES
# ======================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv

# ======================================================
# NOTEBOOK / LOGS
# ======================================================
.ipynb_checkpoints/
*.log

# ======================================================
# SYSTEM / EDITOR FILES
# ======================================================

# VS Code / JetBrains
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ======================================================
# OTHER
# ======================================================
clean_data/

# Environment variables
.env
.env.local
