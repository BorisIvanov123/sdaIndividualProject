# ======================================================
# DATA HANDLING (correct for Streamlit deployment)
# ======================================================

# Ignore all raw data, but keep folder
data/raw_data/*
!data/raw_data/.gitkeep

# Keep processed data in Git (so Streamlit Cloud/Render can read it)
!data/processed_data/
!data/processed_data/**

# ======================================================
# FILE TYPES
# ======================================================

# Excel files
*.xlsx
*.xls

# Logs
*.log

# Jupyter Notebook
.ipynb_checkpoints

# Environment variables
.env
.env.local

# ======================================================
# PYTHON / BUILD FILES
# ======================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv

# ======================================================
# IDE
# ======================================================
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Additional directories
clean_data/
